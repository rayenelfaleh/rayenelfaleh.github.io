---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import { content, profile, type Lang } from '../data/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const cvHref = `${base}${profile.cv[lang]}`;
const navItems = [
  ['projects', t.nav.projects],
  ['about', t.nav.about],
  ['skills', t.nav.skills],
  ['experience', t.nav.experience],
  ['contact', t.nav.contact],
] as const;
const year = new Date().getFullYear();
---

<Base lang={lang} title={t.meta.title} description={t.meta.description}>
  <header class="topbar">
    <div class="container topbar-inner">
      <a href={lang === 'en' ? base : `${base}fr/`} class="brand" aria-label={profile.name}>
        <span class="brand-mark">&gt;_</span>
        <span>rayen<span class="accent">.faleh</span></span>
      </a>
      <nav class="nav" aria-label="Sections">
        {navItems.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
      </nav>
      <div class="topbar-actions">
        <a class="pill-btn" href={`${base}${t.switchHref}`} hreflang={lang === 'fr' ? 'en' : 'fr'}>{t.switchLabel}</a>
        <button class="icon-btn" id="theme-toggle" type="button" aria-label="Toggle theme">
          <span class="sun"><Icon name="sun" /></span>
          <span class="moon"><Icon name="moon" /></span>
        </button>
      </div>
    </div>
  </header>

  <main>
    <!-- Hero -->
    <section class="hero container">
      <div class="hero-copy reveal">
        <p class="status">{t.hero.status}</p>
        <h1>{profile.name}</h1>
        <p class="role mono">{t.hero.role}</p>
        <p class="tagline">{t.hero.tagline}</p>
        <div class="cta">
          <a class="btn primary" href="#projects"><Icon name="arrow" />{t.hero.ctaContact}</a>
          <a class="btn ghost" href={cvHref} download><Icon name="download" />{t.hero.ctaCv}</a>
        </div>
        <div class="socials">
          <a href={profile.github} target="_blank" rel="noopener" aria-label="GitHub"><Icon name="github" /></a>
          <a href={profile.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><Icon name="linkedin" /></a>
          <a href={`mailto:${profile.email}`} aria-label="Email"><Icon name="mail" /></a>
        </div>
      </div>

      <figure class="portrait reveal">
        <img
          src={`${base}rayen-portrait.jpg`}
          alt={lang === 'fr' ? `Portrait de ${profile.name}` : `Portrait of ${profile.name}`}
          width="460"
          height="460"
          fetchpriority="high"
        />
      </figure>
    </section>

    <section class="container stats reveal">
      {t.hero.stats.map((s) => (
        <a class="stat" href={s.href}>
          <span class="stat-value mono">{s.value}</span>
          <span class="stat-label">{s.label}</span>
        </a>
      ))}
    </section>

    <!-- Projects -->
    <section id="projects" class="section container">
      <h2 class="section-title reveal"><span class="mono accent">01.</span> {t.projects.title}</h2>
      <p class="reveal">{t.projects.intro}</p>
      <div class="projects">
        {t.projects.items.map((p) => (
          <article id={p.id} class:list={['card', 'project', 'reveal', { featured: p.featured }]}>
            <div class="project-meta mono">
              <span>{p.kind}</span>
              <span>{p.year}</span>
            </div>
            <h3>{p.title}</h3>
            <p>{p.summary}</p>
            <ul class="points">
              {p.points.map((pt) => <li>{pt}</li>)}
            </ul>
            <ul class="tags mono">
              {p.tags.map((tag) => <li>{tag}</li>)}
            </ul>
            {p.link && (
              <a class="project-link" href={p.link.startsWith('https://') ? p.link : `${base}${p.link}`} target="_blank" rel="noopener">
                {p.linkLabel} <Icon name="arrow" />
              </a>
            )}
          </article>
        ))}
      </div>
      <p class="reveal">{t.projects.catalog}</p>
      <a class="project-link reveal" href={profile.writeups} target="_blank" rel="noopener">{t.projects.catalogLink} <Icon name="arrow" /></a>
    </section>

    <!-- About -->
    <section id="about" class="section container">
      <h2 class="section-title reveal"><span class="mono accent">02.</span> {t.about.title}</h2>
      <div class="about reveal">
        <div class="about-body">
          {t.about.body.map((p) => <p>{p}</p>)}
        </div>
        <dl class="facts">
          {t.about.facts.map((f) => (
            <div>
              <dt>{f.k}</dt>
              <dd>{f.v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- Skills -->
    <section id="skills" class="section container">
      <h2 class="section-title reveal"><span class="mono accent">03.</span> {t.skills.title}</h2>
      <div class="skills">
        {t.skills.groups.map((g) => (
          <article class="card reveal">
            <div class="card-head">
              <span class="card-icon"><Icon name={g.icon} /></span>
              <h3>{g.name}</h3>
            </div>
            <p>{g.context}</p>
            <ul class="chips">
              {g.items.map((i) => <li>{i}</li>)}
            </ul>
            <a class="project-link" href={g.link} target={g.link.startsWith('https://') ? '_blank' : undefined} rel={g.link.startsWith('https://') ? 'noopener' : undefined}>{g.linkLabel} <Icon name="arrow" /></a>
          </article>
        ))}
      </div>
    </section>

    <!-- Experience & education -->
    <section id="experience" class="section container">
      <h2 class="section-title reveal"><span class="mono accent">04.</span> {t.experience.title}</h2>
      <div class="background">
        <div>
          <h3 class="sub-title mono reveal">{t.experience.workTitle}</h3>
          <ol class="timeline">
            {t.experience.work.map((w) => (
              <li class="reveal">
                <div class="tl-head">
                  <h4>{w.role}</h4>
                  <span class="mono period">{w.period}</span>
                </div>
                <p class="org">{w.org}</p>
                <ul class="points">
                  {w.points.map((pt) => <li>{pt}</li>)}
                </ul>
              </li>
            ))}
          </ol>
        </div>
        <div class="side">
          <h3 class="sub-title mono reveal">{t.experience.eduTitle}</h3>
          <ol class="timeline">
            {t.experience.education.map((e) => (
              <li class="reveal">
                <div class="tl-head">
                  <h4>{e.degree}</h4>
                </div>
                <p class="org">{e.school}</p>
                <p class="mono period">
                  {e.period}
                  {e.note && <span class="badge">{e.note}</span>}
                </p>
              </li>
            ))}
          </ol>

          <h3 class="sub-title mono reveal">{t.experience.languagesTitle}</h3>
          <ul class="langs reveal">
            {t.experience.languages.map((l) => (
              <li>
                <div class="lang-row">
                  <span>{l.name}</span>
                  <span class="lang-level">{l.level}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="section container">
      <div class="contact card reveal">
        <p class="mono accent">05. {t.nav.contact}</p>
        <h2>{t.contact.title}</h2>
        <p>{t.contact.body}</p>
        <div class="cta center">
          <a class="btn primary" href={`mailto:${profile.email}`}><Icon name="mail" />{t.contact.email}</a>
          <a class="btn ghost" href={profile.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" />LinkedIn</a>
          <a class="btn ghost" href={profile.github} target="_blank" rel="noopener"><Icon name="github" />GitHub</a>
        </div>
        <p class="mono contact-mail">{profile.email} · {profile.location[lang]}</p>
      </div>
    </section>
  </main>

  <footer class="footer container mono">
    <span>© {year} {profile.name}</span>
    <span>{t.footer}</span>
  </footer>

  <script>
    // Reveal on scroll
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        }),
      { threshold: 0.12 },
    );
    document.querySelectorAll('.reveal').forEach((n) => io.observe(n));

    // Theme toggle
    document.getElementById('theme-toggle').addEventListener('click', () => {
      const root = document.documentElement;
      const current =
        root.dataset.theme || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      const nextTheme = current === 'dark' ? 'light' : 'dark';
      root.dataset.theme = nextTheme;
      try {
        localStorage.setItem('theme', nextTheme);
      } catch {}
    });
  </script>
</Base>
